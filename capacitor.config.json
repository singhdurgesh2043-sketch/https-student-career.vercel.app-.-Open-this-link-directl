{
  "appId": "com.studentcareer.app",
  "appName": "Student Career App",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "cleartext": false,
    "allowNavigation": [
      "student-career.vercel.app",
      "localhost"
    ]
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#1e3a8a",
      "overlaysWebView": false
    }
  }
}
