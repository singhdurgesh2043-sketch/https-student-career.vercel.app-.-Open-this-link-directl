# ==============================================================
# STUDENT CAREER APP - SECURITY CONFIGURATION
# ==============================================================

# 1. Super Admin Secret Access Code (Server-Side)
# Configure in Vercel Dashboard -> Settings -> Environment Variables
# Used by /api/admin-verify serverless endpoint.
# DO NOT commit real secrets to Git.
SUPER_ADMIN_SECRET_CODE=YOUR_PRIVATE_SUPERADMIN_SECRET_CODE_HERE

# 2. Offline / Client-Side Super Admin Code (Placeholder)
# If running offline or inside Capacitor APK without serverless functions,
# the app checks this environment variable or cryptographic hash.
VITE_SUPER_ADMIN_ACCESS_CODE=ADMIN-SECRET-2026

# 3. Optional: Cryptographic SHA-256 Hash of your secret code
# (Alternative to plain code: compute SHA-256 of code + salt)
VITE_SUPER_ADMIN_SECRET_HASH=
