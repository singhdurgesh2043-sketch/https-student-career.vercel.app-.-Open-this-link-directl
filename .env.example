# ==============================================================
# STUDENT CAREER APP - SERVER-SIDE SECURITY CONFIGURATION
# ==============================================================

# 1. Super Admin Secret Access Code (SERVER-SIDE ONLY)
# Configure in Vercel Dashboard -> Project Settings -> Environment Variables
# Used by /api/admin-verify serverless endpoint.
# WARNING: NEVER prefix with VITE_ and NEVER commit private secrets to Git.
SUPER_ADMIN_SECRET_CODE=YOUR_PRIVATE_SUPERADMIN_SECRET_CODE_HERE

# 2. Cryptographic Token Signing Secret (SERVER-SIDE ONLY - Optional)
# If omitted, SUPER_ADMIN_SECRET_CODE is used to sign HMAC-SHA256 session tokens.
SUPER_ADMIN_JWT_SECRET=YOUR_RANDOM_64_CHAR_HEX_SIGNING_SECRET_HERE

# 3. Supabase Cloud Database (Serverless Service Role - SERVER-SIDE ONLY)
# Used for server-side rate-limiting and administrative audit logging.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_SECRET_KEY_HERE

# ==============================================================
# CLIENT-SIDE PUBLIC CONFIGURATION (Safe for Browser & APK)
# ==============================================================
# Notice: Public keys only. Multi-tenant security is enforced via PostgreSQL RLS.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY_HERE
